STORE_CORS=http://localhost:8000,https://docs.medusajs.com

# Public backend URL (no trailing slash). Used in emails and webhooks when set.
# Production example: https://wiffthoeryadmin-medusa-production.up.railway.app
MEDUSA_BACKEND_URL=

# Admin UI base for email links (optional — defaults to MEDUSA_BACKEND_URL + /app).
# Production example: https://wiffthoeryadmin-medusa-production.up.railway.app/app
ADMIN_URL=

# Storefront URL for customer emails (order confirm, welcome, password reset).
STOREFRONT_URL=https://www.whiff-theory.com

# Email — Resend (production on Railway; HTTPS, works on Hobby plan)
RESEND_API_KEY=
# From address — must match your verified domain in Resend
RESEND_FROM="Whiff Theory <hello@whiff-theory.com>"

# Email / SMTP (Gmail — local dev fallback when RESEND_API_KEY is unset)
# Get an App Password at: myaccount.google.com → Security → App Passwords
# Used for store emails and founder task notifications from Budget → Settings emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM="Whiff Theory <your@gmail.com>"
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-v2

# ── Razorpay Standard Checkout ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Legacy aliases still supported: RAZORPAY_TEST_KEY_ID, RAZORPAY_ID, etc.
# RAZORPAY_TEST_WEBHOOK_SECRET=
# RAZORPAY_AUTO_CAPTURE=true

# Storefront (.env.local) — public key only:
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=   (same secret, server-side for /api/create-order & /api/verify-payment)
# NEXT_PUBLIC_SHOP_NAME=Whiff Theory

# ── India checkout shipping ──
# Flat Standard/Express fallback when Shiprocket is unavailable.
# Shop details for packing labels / emails
# SHOP_NAME=Whiff Theory
# SHOP_SUPPORT_PHONE=+917981075481
# SHOP_SUPPORT_EMAIL=hello@whiff-theory.com
# RAZORPAY_AUTO_CAPTURE_MEDUSA=true
# Optional: auto-create fulfillment on order.placed (default: off — pack manually in Admin)
# AUTO_CREATE_FULFILLMENT=true
# Auto mark Medusa shipped/delivered from Shiprocket webhook (default: on)
# SHIPROCKET_AUTO_MARK_SHIPPED=true
# SHIPROCKET_AUTO_MARK_DELIVERED=true
# SHIPPING_EXPRESS_INR=149
# Run once: npm run setup:india-shipping

# ── Shiprocket (live courier rates at checkout + post-order shipment) ──
# Create API user: Panel → Settings → API → Configure → Create API User
# Auth: POST https://apiv2.shiprocket.in/v1/external/auth/login (see https://apidocs.shiprocket.in/)
# SHIPROCKET_DEMO_MODE=false          # false = live API (required for live testing)
# SHIPROCKET_LIVE_CHECKOUT=true       # set false to disable courier list at checkout
# SHIPROCKET_EMAIL=your-api-user@example.com
# SHIPROCKET_PASSWORD=   (or SHIPROCKET_API_KEY — password from API user creation)
# SHIPROCKET_PICKUP_LOCATION=Primary   (exact nickname — run: npm run sync:shiprocket-pickup)
# SHIPROCKET_PICKUP_PHONE=9876543210   (if not on Medusa stock location)
# SHIPROCKET_PICKUP_CONTACT_NAME=Whiff Theory
# SHIPROCKET_PICKUP_CONTACT_EMAIL=hello@whiff-theory.com
# SHIPROCKET_DEFAULT_WEIGHT_KG=0.35
# SHIPROCKET_DEFAULT_HSN=
# Origin pincode for serviceability (auto-resolved from pickup location if unset)
# SHIPROCKET_PICKUP_PINCODE=
# AWB auto-assign runs when customer picks a courier at checkout (no extra flag needed).
# Optional fallback when using flat Standard/Express without courier selection:
# SHIPROCKET_AUTO_ASSIGN_AWB=false
# Status webhook: Panel → Settings → API → Webhook
# URL must NOT contain shiprocket, kartrocket, sr, or kr in the path (Shiprocket rule).
# Example: https://your-backend.up.railway.app/hooks/tracking-updates
# Auth header: x-api-key = SHIPROCKET_WEBHOOK_TOKEN
# SHIPROCKET_WEBHOOK_TOKEN=

# ── Perenual plant docs (admin only — fetch once, store WebP in S3) ──
# NEXT_PLANT_DOCS_API_KEY=
