STORE_CORS=http://localhost:8000,https://docs.medusajs.com

# Public backend URL (no trailing slash). Used in emails and webhooks when set.
# Production example: https://wiffthoeryadmin-medusa-production.up.railway.app
MEDUSA_BACKEND_URL=

# Admin UI base for email links (optional — defaults to MEDUSA_BACKEND_URL + /app).
# Production example: https://wiffthoeryadmin-medusa-production.up.railway.app/app
ADMIN_URL=

# Storefront URL for customer emails (order confirm, welcome, password reset).
# Use your Railway storefront URL until you have a custom domain.
STOREFRONT_URL=http://localhost:8000

# Email / SMTP (Gmail — use an App Password, not your account password)
# Get an App Password at: myaccount.google.com → Security → App Passwords
# Used for store emails and founder task notifications from Budget → Settings emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM="Whiff Theory <your@gmail.com>"
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-v2
